{
  "name": "@brot/desktop",
  "productName": "Brot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm run build && electron .",
    "start:dev": "pnpm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@brot/protocol": "workspace:*",
    "@brot/server": "workspace:*",
    "@brot/ui": "workspace:*",
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.5.1",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "dev.brot.desktop",
    "productName": "Brot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null
    }
  }
}

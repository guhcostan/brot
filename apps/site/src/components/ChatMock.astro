---
import { MessageBubble, StatusDot, ToolCallCard, Badge } from '@brot/ui';
import LiveAvatar from './LiveAvatar';
import { speciesOf } from './species';
import Icon from './Icon.astro';
import { dict, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const t = dict(Astro.props.locale);
const bots = t.team.bots;
const tuca = bots.find((b) => b.name === 'Tuca')!;
const sidebar = [bots[2]!, bots[0]!, bots[1]!, bots[3]!, bots[5]!];
---

<figure class="mock">
  <figcaption class="brot-sr-only">{t.chat.srSummary}</figcaption>
  <div class="mock__window" aria-hidden="true" inert>
    <div class="mock__bar">
      <span class="mock__dot"></span><span class="mock__dot"></span><span class="mock__dot"></span>
    </div>
    <div class="mock__panes">
      <aside class="mock__sidebar">
        <div class="mock__search">{t.chat.search}</div>
        <p class="mock__label">{t.chat.pinned}</p>
        <ul>
          {
            sidebar.map((bot) => (
              <li class:list={['mock__row', { 'is-selected': bot.name === tuca.name }]} data-avatar-zone>
                <LiveAvatar client:visible species={speciesOf(bot)} color={bot.color} mood={bot.mood} size={32} />
                <span class="mock__row-text">
                  <span class="mock__row-name">{bot.name}</span>
                  {bot.status === 'idle' ? (
                    <span class="mock__row-job">{bot.role}</span>
                  ) : (
                    <StatusDot status={bot.status} label={bot.statusLabel} />
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </aside>

      <section class="mock__thread">
        <header class="mock__thread-head" data-avatar-zone>
          <LiveAvatar client:visible species={speciesOf(tuca)} color={tuca.color} mood="approval" size={28} />
          <span class="mock__thread-name">{tuca.name}</span>
          <span class="mock__thread-role">{t.chat.header}</span>
        </header>
        <div class="mock__messages">
          <MessageBubble role="user" content={t.chat.user} time={t.chat.userTime} />
          <MessageBubble role="assistant" author={tuca.name} content={t.chat.reply} time={t.chat.replyTime} />
          <ToolCallCard tool="crm.search" status="ok" summary={t.chat.toolSummary} />
          <section class="brot-approval" data-status="pending">
            <div class="brot-approval__header">
              <StatusDot status="waiting" label={tuca.statusLabel} />
              <Badge>{t.chat.approvalKind}</Badge>
            </div>
            <p class="brot-approval__title">{t.chat.approvalTitle}</p>
            <p class="brot-approval__meta">{t.chat.approvalMeta}</p>
            <div class="brot-approval__actions">
              <span class="brot-button" data-variant="primary" data-size="sm">{t.chat.allowOnce}</span>
              <span class="brot-button" data-variant="secondary" data-size="sm">{t.chat.allowAlways}</span>
              <span class="brot-button" data-variant="danger" data-size="sm">{t.chat.deny}</span>
            </div>
          </section>
        </div>
        <div class="mock__composer">
          <span class="mock__composer-text">{t.chat.composer}</span>
          <span class="mock__send"><Icon name="send" /></span>
        </div>
      </section>

      <aside class="mock__context">
        <div class="mock__context-head">
          <span>{t.chat.computer}</span>
          <span class="mock__live">{t.chat.computerCaption}</span>
        </div>
        <div class="mock__screen">
          <div class="mock__screen-bar"></div>
          {t.chat.screen.map((line, i) => <p class:list={['mock__screen-line', { 'is-body': i === 2 }]}>{line}</p>)}
          <span class="mock__cursor"></span>
        </div>
        <span class="brot-button mock__takeover" data-variant="secondary" data-size="sm">{t.chat.takeOver}</span>
        <div class="mock__tabs">
          {t.chat.tabs.map((tab, i) => <span class:list={{ 'is-active': i === 0 }}>{tab}</span>)}
        </div>
        <ul class="mock__memory">
          {t.chat.memory.map((line) => <li>{line}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</figure>

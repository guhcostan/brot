---
import { BrandMark } from '@brot/ui';
import Icon from './Icon.astro';
import { GITHUB_URL, LOCALES, LOCALE_LABELS, RELEASES_URL, dict, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const links = [
  { href: '#product', label: t.nav.product },
  { href: '#computer', label: t.nav.computer },
  { href: '#use-cases', label: t.nav.useCases },
  { href: '#pricing', label: t.nav.pricing },
  { href: '#faq', label: t.nav.faq },
];
---

<a class="skip" href="#main">{t.nav.skip}</a>
<header class="topbar">
  <div class="topbar__inner">
    <a class="brand" href={localePath(locale)} aria-label="brot">
      <BrandMark size={26} />
      <span class="wordmark" aria-hidden="true">brot</span>
    </a>

    <nav class="pillnav" aria-label={t.nav.label}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <div class="topbar__actions">
      <details class="langmenu">
        <summary aria-label={t.nav.language}>
          <span aria-hidden="true">{LOCALE_LABELS[locale].short}</span>
          <Icon name="chevron" size={14} />
        </summary>
        <ul class="popover">
          {
            LOCALES.map((l) => (
              <li>
                <a href={localePath(l)} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>
                  {LOCALE_LABELS[l].name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="pill pill--ghost topbar__github" href={GITHUB_URL}>
        <Icon name="github" size={16} />
        <span>{t.nav.github}</span>
      </a>
      <a class="pill pill--light" href={RELEASES_URL}>
        <Icon name="download" size={16} />
        <span>{t.nav.download}</span>
      </a>
      <details class="mobilemenu">
        <summary aria-label={t.nav.label}>
          <Icon name="menu" size={18} />
        </summary>
        <nav class="popover popover--menu" aria-label={t.nav.label}>
          {links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={GITHUB_URL}>{t.nav.github}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
